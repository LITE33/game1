# Mode: paper | live | backtest
TRADING_MODE=paper

# API Bearer token for dashboard (set a strong random string)
DASHBOARD_API_TOKEN=change_me_to_something_secure

# Tradovate (futures + commodities)
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_DEMO=true

# OANDA (forex)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Interactive Brokers (options)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# News & Sentiment
NEWSAPI_KEY=
ALPHAVANTAGE_API_KEY=

# Risk limits
DAILY_LOSS_LIMIT_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
PER_TRADE_RISK_PCT=1.5
ALLOW_OVERNIGHT_FUTURES=false

# Paper trading initial capital
PAPER_INITIAL_CAPITAL=100000.0

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
